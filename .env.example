APP_ENV=local
APP_DEBUG=true

# mysql (default). With APP_ENV=local, if MySQL can't be reached the site falls back
# to a demo SQLite file in storage/. Set APP_ENV=production to disable that fallback.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ibits_portal
DB_USERNAME=root
DB_PASSWORD=

